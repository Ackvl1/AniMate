# AniMate 环境变量配置
# 复制此文件为 .env 并填入你的 API Key

# ── LLM Provider ─────────────────────────────────────
# 默认 LLM provider（对应 config.yaml 中 llm 下的 key 名）
ANIMATE_LLM_PROVIDER=deepseek

# DeepSeek（推荐：deepseek-v4-flash）
OPENAI_CHAT_API_KEY=sk-你的key

# 智谱 GLM（可选：glm-4.7, glm-4.5, glm-4v-flash）
# ZAI_API_KEY=你的key

# 阿里通义 Qwen（可选：qwen-3, qwen-2.5）
# QWEN_API_KEY=你的key

# ── Embedding Provider ───────────────────────────────
# 默认 Embedding provider
ANIMATE_EMBEDDING_PROVIDER=dashscope

# 阿里 DashScope（text-embedding-v4）
OPENAI_EMBEDDING_API_KEY=sk-你的key
